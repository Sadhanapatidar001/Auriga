# ===============================================
# Backend Environment Configuration
# ===============================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MySQL Database Connection String
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Note: Use av_room_db for the database name
DATABASE_URL="mysql://root:rootpassword@localhost:3306/av_room_db"

# JWT (JSON Web Token) Secret for Authentication
JWT_SECRET="your_super_secret_jwt_key_replace_this_in_production"

# JWT Expiration Time (e.g. 1d, 7d, 24h)
JWT_EXPIRES_IN="7d"

# Frontend URL for CORS configuration
CLIENT_URL="http://localhost:5173"
